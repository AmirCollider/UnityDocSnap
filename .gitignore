# ==========================================
# Unity DocSnap
#
# This repository is a UPM package, not a Unity project:
# there is no Assets/ or ProjectSettings/ here. So the
# usual Unity .gitignore is mostly irrelevant, and the
# entries that matter are the ones covering what appears
# when somebody EMBEDS this package in a project to work
# on it, plus the tool's own output.
# ==========================================

# ---- The tool's own output ----
# The default export destination. A contributor testing a
# change generates one of these immediately, and it is
# thousands of files.
UnityDocSnap_Output/

# ---- Unity, when this package is embedded in a project ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ---- Generated by the IDE integrations ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Build artefacts ----
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# ---- OS noise ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Local tooling ----
__pycache__/
*.py[cod]
node_modules/
