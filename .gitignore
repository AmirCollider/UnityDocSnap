# This repository is a Unity PACKAGE, not a project - there is no
# Library/ or Temp/ here unless somebody opened it as one by mistake,
# which is exactly what this file is for.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Solution and project files, generated by Unity from the package.
*.csproj
*.sln
*.unityproj
*.user
*.pidb
*.booproj
.vs/
.idea/
.vscode/

# Operating systems leaving notes to themselves.
.DS_Store
Thumbs.db

# ==========================================
# NOT ignored: Editor/UnityDocSnap/*.dll
#
# The shipped Editor assembly IS the product here - this
# repository exists to deliver it - so the usual "never commit a
# DLL" reflex is exactly wrong on this side. It is ignored in the
# SOURCE repository, where a DLL can only be a build output that
# wandered in, and committed here, where it is the release.
# ==========================================
